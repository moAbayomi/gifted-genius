# Copy to `.env` for local development.
# Values below match docker-compose.yml and are safe to commit — no real secrets.

NODE_ENV=development
APP_STAGE=development
PORT=3000

# Local Postgres from `docker compose up -d db`
DB_URL=postgres://postgres:postgres@localhost:5432/gifted_mind_dev

SESSION_TTL_DAYS=7

# Comma-separated. The browser origin(s) allowed to send credentialed requests.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Password given to every demo user created by `npm run seed` (min 10 chars).
SEED_PASSWORD=demo-password-1234

# Serve Swagger UI at /docs and the spec at /openapi.json.
# Defaults to on outside production. Set to false to hide them.
DOCS_ENABLED=true

# Uncomment only when cookies must be shared across subdomains,
# e.g. COOKIE_DOMAIN=.giftedmind.test
# COOKIE_DOMAIN=

# The seed script refuses to run in production unless this is true.
# ALLOW_DEMO_SEED=false
