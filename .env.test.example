# Copy to `.env.test` before running the test suite.
# Matches the `db-test` service in docker-compose.yml (port 5433).
# The test database is tmpfs-backed and is wiped when the container stops.

NODE_ENV=test
APP_STAGE=test

DB_URL=postgres://postgres:postgres@localhost:5433/gifted_mind_test

SESSION_TTL_DAYS=7

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Required by the seed helper used in integration tests (min 10 chars).
SEED_PASSWORD=test-password-1234

# Needed by the OpenAPI/docs tests.
DOCS_ENABLED=true
